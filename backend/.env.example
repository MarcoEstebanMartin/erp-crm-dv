PORT=3001
NODE_ENV="development"

# URL de conexión a PostgreSQL en Supabase (ERP principal: erp-dv).
# DATABASE_URL usa el pooler (puerto 6543) y DIRECT_URL conexión directa (puerto 5432).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Base de datos del Catálogo/Tienda Web (chatbot-dv) para banco único de imágenes y pedidos web
PRODUCTION_CATALOG_DATABASE_URL="postgresql://postgres.[WEB_PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
ALLOW_PRODUCTION_CATALOG_WRITE="false"

# Dominios permitidos explícitamente en producción (obligatorio cuando NODE_ENV=production)
CORS_ORIGIN="https://sistema.donvenancio.com.ar"

# Clave secreta criptográfica para firmar cookies JWT HttpOnly y clave de backups cifrados AES-256-GCM
JWT_SECRET="cambiar-por-clave-criptografica-larga-y-aleatoria"
BACKUP_ENCRYPTION_KEY="cambiar-por-clave-de-respaldo-cifrado"

# Configuración de AFIP / ARCA
AFIP_CUIT="20123456789"
AFIP_PRODUCTION="false"
AFIP_CERT_PATH="./certs/homo.crt"
AFIP_KEY_PATH="./certs/homo.key"

# Integraciones Externas (Gemini OCR y Meta WhatsApp Cloud API)
GEMINI_API_KEY="tu-api-key-aqui"
IGNORE_STOCK_CHECK="false"
WHATSAPP_ENABLED="false"
WHATSAPP_TOKEN="EAAxxxxxxx..."
WHATSAPP_PHONE_NUMBER_ID="100xxxxxxx..."
WHATSAPP_VERIFY_TOKEN="dv_crm_secure_token"
