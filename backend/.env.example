PORT=3000

# URL de conexión a la base de datos PostgreSQL de Supabase.
# Prisma utiliza DATABASE_URL para consultas y DIRECT_URL si se usa un pooler (ej. Transaction mode).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# Clave secreta para firmar los tokens JWT (cambiar por una cadena larga y aleatoria)
JWT_SECRET="super-secret-key-for-jwt-change-this-in-production"

# Configuración de AFIP
# CUIT de la empresa sin guiones (ej. 20123456789)
AFIP_CUIT="20123456789"
# Entorno de AFIP: 'false' para Homologación (pruebas), 'true' para Producción
AFIP_PRODUCTION="false"
# Rutas relativas o absolutas a los certificados provistos por AFIP
AFIP_CERT_PATH="./certs/homo.crt"
AFIP_KEY_PATH="./certs/homo.key"

# Clave de API para Google Gemini (procesamiento de comprobantes con IA)
GEMINI_API_KEY="tu-api-key-aqui"

# Opción para ignorar los controles de stock estrictos durante las pruebas
IGNORE_STOCK_CHECK="false"
