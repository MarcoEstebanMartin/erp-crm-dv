generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  FACTURACION
  VENDEDOR
  DEPOSITO
}

enum BillingType {
  OFFICIAL
  INTERNAL
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  PRESUPUESTO
}

enum OrderStatus {
  PENDING
  PREPARING
  PREPARED
  DELIVERED
  CANCELLED
}

enum CreditNoteStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum TransactionType {
  INCOME
  OUTCOME
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  OTHER
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(VENDEDOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  orders         Order[]
  transactions   Transaction[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  personas       Persona[]
  cashDrawers    CashDrawer[]
  creditNotes    CreditNote[]
  saleRoutes     SaleRoute[]
  routeVisits    SaleRouteVisit[]
  expenses       Expense[]
  employee       Employee?
  crmConversations CrmConversation[] @relation("CrmAssignedUser")
  weeklySchedules  WeeklySchedule[]
}

model Persona {
  id       Int     @id @default(autoincrement())
  name     String
  cuit     String?
  address  String?
  city     String?
  province String?
  zipCode  String?
  phone    String?
  email    String?
  rubro    String?

  // Roles de Persona
  isClient          Boolean @default(true)
  isProvider        Boolean @default(false)
  isSeller          Boolean @default(false)
  isCommissionAgent Boolean @default(false)

  // Datos de Cliente
  creditLimit Decimal @default(0.00) @db.Decimal(12, 2)
  maxUnpaidInvoices Decimal @default(0.00) @db.Decimal(5, 2)
  priceList   String  @default("A")
  discount    Decimal @default(0.00) @db.Decimal(12, 2)
  contacts    Json?

  // Cuenta Corriente (neto: positivo = nos debe, negativo = le debemos)
  outstandingBalance Decimal @default(0.00) @db.Decimal(12, 2)

  // Ruta de reparto (ej: "BUNGE Y BUCHARDO", "VILLEGAS NORBER", etc.)
  route String?

  // Relación con Ruta de Preventa estructurada
  saleRouteId   Int?
  saleRoute     SaleRoute? @relation(fields: [saleRouteId], references: [id], onDelete: SetNull)
  routeSequence Int? // Orden en la secuencia de visita (1, 2, 3...)

  // Coordenadas geográficas para reparto y preventa
  latitude  Float?
  longitude Float?

  // Relación con vendedor (si es cliente)
  sellerId Int?
  seller   User? @relation(fields: [sellerId], references: [id])

  // Alícuota impositiva para percepción IIBB (ej: 1.50)
  iibbAliquot Decimal @default(0.00) @db.Decimal(5, 2)

  // Plazo de pago acordado (en días)
  paymentTermDays Int @default(30)

  // PIN Secreto de Acceso a la Tienda Online (4-6 dígitos)
  webPin String?

  // Estado activo/inactivo
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  orders              Order[]
  transactions        Transaction[]
  supplierInvoices    SupplierInvoice[]
  taxWithholdings     TaxWithholding[]
  purchaseOrders      PurchaseOrder[]
  creditNotes         CreditNote[]
  products            Product[]
  discountRules       DiscountRule[]
  splitBillingConfigs SplitBillingConfig[]
  routeVisits         SaleRouteVisit[]
  vehicleMaintenances VehicleMaintenance[]
  providerMappings    ProviderProductMapping[]
  crmConversations    CrmConversation[]
  crmDrafts           CrmOrderDraft[]

  @@index([sellerId])
  @@index([isClient])
  @@index([isProvider])
  @@index([saleRouteId])
}

model Product {
  id                Int      @id @default(autoincrement())
  sku               String   @unique
  name              String
  description       String?
  barcode           String?  @unique
  costPrice         Decimal  @db.Decimal(12, 2)
  listPrice         Decimal  @db.Decimal(12, 2)
  listPriceB        Decimal  @default(0.00) @db.Decimal(12, 2)
  listPriceC        Decimal  @default(0.00) @db.Decimal(12, 2)
  profitMargin      Decimal? @db.Decimal(5, 2)
  stock             Int      @default(0)
  minStock          Int      @default(0)
  isPesable         Boolean  @default(false)
  unitsPerBox       Int      @default(1)
  approximateWeight Decimal? @db.Decimal(12, 3)
  imageUrl          String?
  commercialCategory String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relaciones
  orderItems         OrderItem[]
  stockMovements     StockMovement[]
  lots               ProductLot[]
  purchaseOrderItems PurchaseOrderItem[]
  creditNoteItems    CreditNoteItem[]
  rubroId            Int?
  rubro              Rubro?                   @relation(fields: [rubroId], references: [id])
  providerId         Int?
  provider           Persona?                 @relation(fields: [providerId], references: [id])
  discountRules      DiscountRule[]
  providerMappings   ProviderProductMapping[]
  offerCampaignItems OfferCampaignItem[]

  @@index([rubroId])
  @@index([providerId])
}

model Order {
  id                  Int         @id @default(autoincrement())
  movementId          Int         @default(dbgenerated("nextval('movement_seq')"))
  personaId           Int
  persona             Persona     @relation(fields: [personaId], references: [id])
  sellerId            Int
  seller              User        @relation(fields: [sellerId], references: [id])
  billingType         BillingType @default(INTERNAL)
  invoiceType         InvoiceType @default(PRESUPUESTO)
  invoiceNumber       String?
  cae                 String?
  caeDueDate          DateTime?
  status              OrderStatus @default(PENDING)
  totalAmount         Decimal     @db.Decimal(12, 2)
  netAmount           Decimal     @default(0.00) @db.Decimal(12, 2) // Neto Gravado
  taxAmount           Decimal     @default(0.00) @db.Decimal(12, 2) // IVA Débito Fiscal
  percepcionAmount    Decimal     @default(0.00) @db.Decimal(12, 2) // Percepciones IIBB
  percepcionIvaAmount Decimal     @default(0.00) @db.Decimal(12, 2) // Percepciones IVA (ej: RG 5329)
  bultosCount         Int         @default(1)
  bultosDetails       Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relaciones
  items           OrderItem[]
  transactions    Transaction[]
  deliveryRouteId Int?
  deliveryRoute   DeliveryRoute? @relation(fields: [deliveryRouteId], references: [id])
  creditNotes     CreditNote[]
  crmDraft        CrmOrderDraft?

  @@index([personaId])
  @@index([sellerId])
  @@index([createdAt])
  @@index([status])
  @@index([deliveryRouteId])
}

model OrderItem {
  id            Int            @id @default(autoincrement())
  orderId       Int
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product        @relation(fields: [productId], references: [id])
  quantity      Int
  weight        Decimal?       @db.Decimal(12, 3)
  unitPrice     Decimal        @db.Decimal(12, 2)
  subtotal      Decimal        @db.Decimal(12, 2)
  orderItemLots OrderItemLot[]

  @@index([orderId])
  @@index([productId])
}

model ProductLot {
  id             Int      @id @default(autoincrement())
  productId      Int
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber      String
  expirationDate DateTime
  stock          Int      @default(0)
  location       String   @default("S/U")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  orderItemLots  OrderItemLot[]
  stockMovements StockMovement[]

  @@unique([productId, lotNumber])
}

model OrderItemLot {
  id           Int        @id @default(autoincrement())
  orderItemId  Int
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productLotId Int
  productLot   ProductLot @relation(fields: [productLotId], references: [id])
  quantity     Int

  @@index([orderItemId])
  @@index([productLotId])
}

model StockMovement {
  id           Int          @id @default(autoincrement())
  productId    Int
  product      Product      @relation(fields: [productId], references: [id])
  quantity     Int // Positivo para entrada, negativo para salida
  type         MovementType
  referenceId  String? // ID del pedido u orden de compra
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  reason       String?
  productLotId Int?
  productLot   ProductLot?  @relation(fields: [productLotId], references: [id])
  createdAt    DateTime     @default(now())

  @@index([productId])
  @@index([userId])
  @@index([productLotId])
  @@index([createdAt])
}

model CashDrawer {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  branch         String // "A" | "X" (Sucursal A / X)
  drawerType     String    @default("DEPOSITO") // "DEPOSITO" | "VENDEDOR" | "REPARTIDOR"
  routeNote      String? // Pueblo o Ruta de cobro (ej: "General Villegas / Bunge")
  notes          String? // Observaciones o notas adicionales de arqueo
  openingBalance Decimal   @db.Decimal(12, 2)
  closingBalance Decimal?  @db.Decimal(12, 2)
  realBalance    Decimal?  @db.Decimal(12, 2)
  status         String    @default("OPEN") // "OPEN" | "CLOSED"
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  // Relaciones
  transactions Transaction[]
  expenses     Expense[]
  salaryAdvances SalaryAdvance[]
  payrolls       Payroll[]

  @@index([userId])
  @@index([status])
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  name          String
  accountNumber String?
  balance       Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  transactions Transaction[]
  expenses     Expense[]
  salaryAdvances SalaryAdvance[]
  payrolls       Payroll[]
}

model Transaction {
  id            Int             @id @default(autoincrement())
  movementId    Int             @default(dbgenerated("nextval('movement_seq')"))
  orderId       Int?
  order         Order?          @relation(fields: [orderId], references: [id])
  personaId     Int?
  persona       Persona?        @relation(fields: [personaId], references: [id])
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  billingType   BillingType
  type          TransactionType
  paymentMethod PaymentMethod
  amount        Decimal         @db.Decimal(12, 2)
  description   String?
  receiptNumber String?         @unique // Nro de recibo ej: "REC-00001"

  // Relaciones Financieras
  cashDrawerId  Int?
  cashDrawer    CashDrawer?  @relation(fields: [cashDrawerId], references: [id])
  bankAccountId Int?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Relación con facturas de proveedor
  supplierInvoiceId Int?
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  // Relación con mantenimiento de flota
  vehicleMaintenances VehicleMaintenance[]
  fuelLogs            FuelLog[]

  // Relación uno a uno con gastos
  expense Expense?
  salaryAdvance SalaryAdvance?
  payroll       Payroll?

  createdAt DateTime @default(now())
  verified  Boolean  @default(false)

  @@index([orderId])
  @@index([personaId])
  @@index([userId])
  @@index([cashDrawerId])
  @@index([bankAccountId])
  @@index([supplierInvoiceId])
  @@index([createdAt])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  action       String // ej. "UPDATE_PRODUCT", "CREATE_ORDER", "ADJUST_STOCK"
  entityType   String // ej. "Product", "Order"
  entityId     Int
  oldValues    Json?
  newValues    Json?
  status       String   @default("SUCCESS") // "SUCCESS" | "ERROR" | "WARNING"
  errorMessage String?  @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SupplierInvoice {
  id                  Int           @id @default(autoincrement())
  movementId          Int           @default(dbgenerated("nextval('movement_seq')"))
  personaId           Int
  persona             Persona       @relation(fields: [personaId], references: [id])
  invoiceNumber       String // Nro comprobante ej: "0001-00004321"
  invoiceType         String // "FACTURA_A" | "FACTURA_B" | "FACTURA_C"
  issueDate           DateTime
  dueDate             DateTime? // Fecha de vencimiento
  status              String        @default("PENDING") // "PENDING" | "PAID" | "PARTIALLY_PAID"
  paidAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  netAmount           Decimal       @db.Decimal(12, 2) // Neto Gravado
  taxAmount           Decimal       @db.Decimal(12, 2) // IVA Crédito Fiscal
  percepcionAmount    Decimal       @default(0.00) @db.Decimal(12, 2) // Percepciones IIBB sufridas
  percepcionIvaAmount Decimal       @default(0.00) @db.Decimal(12, 2) // Percepciones IVA sufridas
  impuestosInternos   Decimal       @default(0.00) @db.Decimal(12, 2) // Impuestos Internos
  totalAmount         Decimal       @db.Decimal(12, 2) // Total
  billingType         BillingType   @default(INTERNAL)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  transactions        Transaction[]

  @@index([personaId])
  @@index([issueDate])
  @@index([status])
}

model TaxWithholding {
  id           Int      @id @default(autoincrement())
  movementId   Int      @default(dbgenerated("nextval('movement_seq')"))
  type         String // "PERCEPCION_SUFRIDA" | "PERCEPCION_PRACTICADA" | "RETENCION_SUFRIDA" | "RETENCION_PRACTICADA"
  taxType      String // "IIBB" | "IVA" | "GANANCIAS"
  personaId    Int
  persona      Persona  @relation(fields: [personaId], references: [id])
  number       String // Nro certificado o comprobante
  date         DateTime
  amount       Decimal  @db.Decimal(12, 2)
  jurisdiction String? // Jurisdicción si es IIBB (ej: "AR-B", "AR-C")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([personaId])
  @@index([taxType])
  @@index([date])
}

model DeliveryRoute {
  id                 Int      @id @default(autoincrement())
  driverName         String
  vehiclePlate       String
  vehicleDescription String?
  status             String   @default("PENDING") // "PENDING" | "IN_TRANSIT" | "COMPLETED"
  date               DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relación con flota de vehículos propia (opcional)
  vehicleId Int?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([vehicleId])
}

model PurchaseOrder {
  id          Int      @id @default(autoincrement())
  personaId   Int
  persona     Persona  @relation(fields: [personaId], references: [id])
  status      String   @default("PENDING") // "PENDING" | "RECEIVED" | "CANCELLED"
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PurchaseOrderItem[]

  @@index([personaId])
  @@index([status])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  costPrice       Decimal       @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)

  @@index([purchaseOrderId])
  @@index([productId])
}

model CreditNote {
  id               Int              @id @default(autoincrement())
  movementId       Int              @default(dbgenerated("nextval('movement_seq')"))
  personaId        Int
  persona          Persona          @relation(fields: [personaId], references: [id])
  orderId          Int? // Vinculación opcional a una factura/pedido específico
  order            Order?           @relation(fields: [orderId], references: [id])
  userId           Int
  user             User             @relation(fields: [userId], references: [id])
  status           CreditNoteStatus @default(PENDING_APPROVAL)
  billingType      BillingType      @default(INTERNAL)
  creditNoteType   String // "NOTA_CREDITO_A" | "NOTA_CREDITO_B" | "NOTA_CREDITO_C" | "NOTA_CREDITO_INTERNA"
  creditNoteNumber String? // Nro comprobante ej: "00001-00000124"
  cae              String?
  caeDueDate       DateTime?
  totalAmount      Decimal          @db.Decimal(12, 2)
  netAmount        Decimal          @default(0.00) @db.Decimal(12, 2)
  taxAmount        Decimal          @default(0.00) @db.Decimal(12, 2)
  reason           String // "DEVOLUCION" | "DESCUENTO" | "ERROR_FACTURACION"
  comments         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items CreditNoteItem[]

  @@index([personaId])
  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model CreditNoteItem {
  id           Int        @id @default(autoincrement())
  creditNoteId Int
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  weight       Decimal?   @db.Decimal(12, 3)
  unitPrice    Decimal    @db.Decimal(12, 2)
  subtotal     Decimal    @db.Decimal(12, 2)

  @@index([creditNoteId])
  @@index([productId])
}

model Rubro {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  description         String?
  profitMargin        Decimal              @default(1.25) @db.Decimal(5, 2)
  pickingZone         String               @default("CAJAS") // FRIO, TABLA, CAJAS
  products            Product[]
  discountRules       DiscountRule[]
  splitBillingConfigs SplitBillingConfig[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model WeeklyReport {
  id        Int      @id @default(autoincrement())
  weekStart String   @unique // Formato "YYYY-MM-DD" (Lunes de la semana)
  purchases Json // Lista de compras: [{ company: string, date: string, amount: number }]
  sales     Json // Lista de ventas por localidad: [{ locality: string, date: string, amountA: number, amountX: number }]
  credit    Decimal  @db.Decimal(12, 2) // Rollover de crédito / deuda
  buffer    Decimal  @default(20000000.00) @db.Decimal(12, 2) // Colchón operativo (Resultado)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PerceptionType {
  id             Int      @id @default(autoincrement())
  code           String   @unique // Ej: "IVA_5329", "IIBB_MN", "IIBB_CR", "IIBB_BA"
  name           String
  taxType        String // "IVA" | "IIBB"
  aliquot        Decimal  @db.Decimal(5, 2)
  affectsIvaBook Boolean  @default(false)
  jurisdiction   String? // Ej: "AR-N", "AR-W", "AR-B", o null para IVA
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DiscountRule {
  id   Int     @id @default(autoincrement())
  name String? // Nombre descriptivo (ej: "Descuento 3% Especial Quesos", "Fanberlian General 4%")

  // Condicionales de aplicación (nulos = aplica a todo)
  personaId Int? // Cliente específico (ej. FANBERLIAN)
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: Cascade)

  priceList String? // Código de lista de precios (ej. "ESPECIAL_QUESOS") para agrupar clientes

  rubroId Int? // Rubro de producto al que aplica (ej. Remotti, Quesos Melincue)
  rubro   Rubro? @relation(fields: [rubroId], references: [id], onDelete: Cascade)

  productId Int? // Producto específico al que aplica
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  billingType BillingType? // Si aplica solo a Sucursal A (OFFICIAL) o Sucursal X (INTERNAL)

  // Beneficio
  discount Decimal @db.Decimal(5, 2) // Porcentaje de descuento (ej. 3.00, 4.00)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personaId])
  @@index([priceList])
  @@index([rubroId])
  @@index([productId])
}

model SplitBillingConfig {
  id        Int     @id @default(autoincrement())
  personaId Int // Cliente al que aplica (ej. FANBERLIAN)
  persona   Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  rubroId Int // Rubro que se divide (ej. Remotti, Quesos Melincué)
  rubro   Rubro @relation(fields: [rubroId], references: [id], onDelete: Cascade)

  percentageOfficial Decimal @default(50.00) @db.Decimal(5, 2) // % en Sucursal A (Oficial)
  percentageInternal Decimal @default(50.00) @db.Decimal(5, 2) // % en Sucursal X (Interno)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personaId, rubroId])
}

model SaleRoute {
  id        Int      @id @default(autoincrement())
  name      String // Ej: "General Villegas - Centro 1"
  sellerId  Int? // Vendedor asignado principal
  seller    User?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  dayOfWeek String? // LUNES, MARTES, MIERCOLES, JUEVES, VIERNES, SABADO, DOMINGO
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients     Persona[]
  routeVisits SaleRouteVisit[]

  @@index([sellerId])
}

model SaleRouteVisit {
  id          Int        @id @default(autoincrement())
  date        DateTime   @default(now())
  sellerId    Int
  seller      User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  personaId   Int
  persona     Persona    @relation(fields: [personaId], references: [id], onDelete: Cascade)
  saleRouteId Int?
  saleRoute   SaleRoute? @relation(fields: [saleRouteId], references: [id], onDelete: SetNull)
  status      String // "ORDERED" (Compró) | "NO_BUY" (No compró)
  noBuyReason String? // Motivo si es NO_BUY (ej: "Sin dinero", "Cerrado")
  notes       String? // Comentarios opcionales
  latitude    Float? // GPS de la visita
  longitude   Float?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sellerId])
  @@index([personaId])
  @@index([saleRouteId])
  @@index([date])
}

// ==========================================
// Módulo de Flota de Vehículos
// ==========================================

model Vehicle {
  id              Int           @id @default(autoincrement())
  plate           String        @unique // Patente/Dominio
  brand           String // Marca (Mercedes Benz, Fiat, etc.)
  model           String // Modelo (Accelo 815, Fiorino, etc.)
  year            Int
  currentOdometer Int // Kilometraje actual acumulado
  status          VehicleStatus @default(ACTIVE) // ACTIVE, MAINTENANCE, OUT_OF_SERVICE
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  maintenances   VehicleMaintenance[]
  expirations    VehicleExpiry[]
  deliveryRoutes DeliveryRoute[] // Hojas de reparto que usaron este vehículo
  expenses       Expense[]
  fuelLogs       FuelLog[]
}

model VehicleMaintenance {
  id          Int             @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        MaintenanceType // SERVICE, REPAIR, FUEL, CLEANING, OTHER
  description String          @db.Text
  cost        Decimal         @db.Decimal(12, 2)
  odometer    Int // Kilometraje en el que se realizó
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Proveedor/Taller opcional (vinculado a Persona)
  supplierId Int?
  supplier   Persona? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  // Transacción financiera opcional para descontar de caja o banco
  transactionId Int?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([supplierId])
  @@index([transactionId])
}

model VehicleExpiry {
  id             Int        @id @default(autoincrement())
  vehicleId      Int
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type           ExpiryType // INSURANCE, VTE_ITV, PATENT, CARNET, OTHER
  description    String
  expirationDate DateTime
  alertSent      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([vehicleId])
}

model FuelLog {
  id            Int          @id @default(autoincrement())
  vehicleId     Int
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date          DateTime     @default(now())
  odometer      Int          // Odómetro al momento de la carga (km)
  liters        Decimal      @db.Decimal(10, 2) // Litros cargados
  totalCost     Decimal      @db.Decimal(12, 2) // Monto total $
  pricePerLiter Decimal?     @db.Decimal(10, 2) // Precio / L opcional
  isFullTank    Boolean      @default(true)     // Permite calcular L/100km exactos
  notes         String?      @db.Text

  // Transacción financiera opcional para descontar de caja o banco
  transactionId Int?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([vehicleId])
  @@index([date])
  @@index([transactionId])
}

// ==========================================
// Módulo de Control de Gastos Operativos
// ==========================================

model ExpenseCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          Int             @id @default(autoincrement())
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  description String
  categoryId  Int
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  userId      Int
  user        User            @relation(fields: [userId], references: [id])

  // Origen de fondos
  paymentMethod PaymentMethod
  cashDrawerId  Int?
  cashDrawer    CashDrawer?   @relation(fields: [cashDrawerId], references: [id])
  bankAccountId Int?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])

  // Imputación a vehículo de la flota
  vehicleId Int?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Vinculación financiera (para egresos de caja/banco)
  transactionId Int?         @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([userId])
  @@index([date])
  @@index([cashDrawerId])
  @@index([bankAccountId])
  @@index([vehicleId])
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum MaintenanceType {
  SERVICE
  REPAIR
  FUEL
  CLEANING
  OTHER
}

enum ExpiryType {
  INSURANCE
  VTE_ITV
  PATENT
  CARNET
  OTHER
}

model ProviderProductMapping {
  id           Int      @id @default(autoincrement())
  providerId   Int
  provider     Persona  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerCode String // Código de artículo según el proveedor (ej: "07300101000")
  providerName String? // Descripción según el proveedor (ej: "LECHE UAT SACHET DESC. 1 LT")
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([providerId, providerCode])
  @@index([providerId])
  @@index([productId])
}

// ==========================================
// Módulo de Campañas de Ofertas
// ==========================================

model OfferCampaign {
  id               Int       @id @default(autoincrement())
  title            String // Ej: "Ofertas Semanales 18 al 25"
  startDate        DateTime  @default(now())
  endDate          DateTime?
  isActive         Boolean   @default(true)
  customRubroOrder String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items OfferCampaignItem[]
}

model OfferCampaignItem {
  id         Int           @id @default(autoincrement())
  campaignId Int
  campaign   OfferCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  offerPrice Decimal       @db.Decimal(12, 2)
  previousPrice Decimal?   @db.Decimal(12, 2)
  specialTag String? // Ej: "¡OFERTÓN!", "¡ÚLTIMAS UNIDADES!"

  showListPrice Boolean @default(false)
  campaignGroup String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
}

// ==========================================
// Módulo de Recursos Humanos y Nómina (RRHH)
// ==========================================

model Employee {
  id               Int       @id @default(autoincrement())
  userId           Int?      @unique
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  dni              String    @unique
  cuil             String?
  email            String?
  phone            String?
  address          String?
  position         String    // Ej: "Chofer / Repartidor", "Vendedor Preventista", "Operario Depósito", "Administrativo"
  department       String    @default("OPERACIONES") // "LOGISTICA", "VENTAS", "DEPOSITO", "ADMINISTRACION"
  hireDate         DateTime
  baseSalary       Decimal   @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(BANK_TRANSFER)
  cbuAlias         String?
  bankName         String?
  birthDate        DateTime?
  emergencyContact String?
  notes            String?   @db.Text
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  advances  SalaryAdvance[]
  payrolls  Payroll[]
  vacations EmployeeVacation[]
  documents EmployeeDocument[]

  @@index([position])
  @@index([department])
}

model SalaryAdvance {
  id            Int           @id @default(autoincrement())
  employeeId    Int
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime      @default(now())
  reason        String?
  status        String        @default("PENDING") // "PENDING", "DEDUCTED", "CANCELLED"
  paymentMethod PaymentMethod @default(CASH)

  cashDrawerId  Int?
  cashDrawer    CashDrawer?   @relation(fields: [cashDrawerId], references: [id], onDelete: SetNull)
  bankAccountId Int?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  transactionId Int?          @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  payrollId     Int?
  payroll       Payroll?      @relation(fields: [payrollId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@index([payrollId])
  @@index([cashDrawerId])
  @@index([bankAccountId])
}

model Payroll {
  id                Int           @id @default(autoincrement())
  employeeId        Int
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodMonth       Int           // 1 - 12
  periodYear        Int           // Ej: 2026
  baseSalary        Decimal       @db.Decimal(12, 2)
  commissions       Decimal       @default(0.00) @db.Decimal(12, 2)
  overtimeAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  bonuses           Decimal       @default(0.00) @db.Decimal(12, 2)
  grossSalary       Decimal       @db.Decimal(12, 2)
  advancesDeduction Decimal       @default(0.00) @db.Decimal(12, 2)
  otherDeductions   Decimal       @default(0.00) @db.Decimal(12, 2)
  netSalary         Decimal       @db.Decimal(12, 2)
  status            String        @default("DRAFT") // "DRAFT", "APPROVED", "PAID"
  paymentDate       DateTime?
  paymentMethod     PaymentMethod?

  cashDrawerId      Int?
  cashDrawer        CashDrawer?   @relation(fields: [cashDrawerId], references: [id], onDelete: SetNull)
  bankAccountId     Int?
  bankAccount       BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  transactionId     Int?          @unique
  transaction       Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  advances          SalaryAdvance[]

  @@unique([employeeId, periodMonth, periodYear])
  @@index([employeeId])
  @@index([status])
}

model EmployeeVacation {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year        Int      // Año lectivo (ej. 2026)
  type        String   @default("VACATION") // "VACATION", "SICK_LEAVE", "STUDY", "PERSONAL", "PATERNITY_MATERNITY", "OTHER"
  startDate   DateTime
  endDate     DateTime
  daysCount   Int
  status      String   @default("APPROVED") // "PENDING", "APPROVED", "REJECTED", "TAKEN"
  comments    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
}

model EmployeeDocument {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           String   // "CARNET_CONDUCIR", "LINTI", "EXAMEN_MEDICO", "MANIPULACION_ALIMENTOS", "CONTRATO", "OTRO"
  description    String
  expirationDate DateTime
  alertSent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId])
  @@index([expirationDate])
}

// ==========================================
// MÓDULO CRM & WHATSAPP (ISLADO RIESGO CERO)
// ==========================================

enum CrmMessageDirection {
  INBOUND
  OUTBOUND
}

enum CrmMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum CrmDraftStatus {
  PENDING
  APPROVED
  REJECTED
}

model CrmConversation {
  id               Int      @id @default(autoincrement())
  waId             String   @unique
  contactName      String?
  personaId        Int?
  persona          Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  stage            String   @default("LEAD") // LEAD, CONTACTED, QUOTED, WON, LOST
  autoReplyEnabled Boolean  @default(true)
  assignedSellerId Int?
  assignedUser     User?    @relation("CrmAssignedUser", fields: [assignedSellerId], references: [id], onDelete: SetNull)
  lastMessageAt    DateTime @default(now())
  unreadCount      Int      @default(0)
  status           String   @default("ACTIVE") // ACTIVE, ARCHIVED, CLOSED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages CrmMessage[]
  drafts   CrmOrderDraft[]

  @@index([waId])
  @@index([personaId])
  @@index([assignedSellerId])
  @@index([lastMessageAt])
  @@index([stage])
}

model CrmMessage {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  conversation   CrmConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      CrmMessageDirection
  body           String
  mediaUrl       String?
  mediaType      String? // image, audio, document, video
  wamid          String?             @unique
  status         CrmMessageStatus    @default(SENT)
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model CrmOrderDraft {
  id             Int             @id @default(autoincrement())
  conversationId Int
  conversation   CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  personaId      Int?
  persona        Persona?        @relation(fields: [personaId], references: [id], onDelete: SetNull)
  rawText        String
  itemsJson      String // JSON Array con productos detectados
  totalEstimated Decimal         @db.Decimal(12, 2)
  status         CrmDraftStatus  @default(PENDING)
  orderId        Int?            @unique
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([conversationId])
  @@index([status])
}

model WeeklySchedule {
  id           Int      @id @default(autoincrement())
  weekType     String   @default("SEMANA_1") // "SEMANA_1", "SEMANA_2", "TODAS"
  dayOfWeek    String   // "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO", "DOMINGO"
  activityType String   @default("PREVENTA") // "PREVENTA", "REPARTO", "COBRANZA", "AMBOS", "OTRO"
  sellerId     Int?
  seller       User?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerName   String?  // Ej: "Fabián", "Marcos", "Reparto General"
  location     String   // Ej: "América", "General Villegas", "Banderaló", "Carlos Tejedor"
  description  String?  // Detalle o observaciones adicionales
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([weekType])
  @@index([dayOfWeek])
  @@index([sellerId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


